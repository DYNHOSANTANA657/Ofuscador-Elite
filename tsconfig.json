{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["ui/**/*.tsx", "portable-ui/**/*.tsx", "portable.vite.config.ts"],
  "exclude": ["node_modules", "backend", "dist", "site"]
}
